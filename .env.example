APP_ENVIRONMENT=local
APP_NAME=algo-trading
LOG_LEVEL=INFO

DATABASE_PASSWORD=change-me

# Alpaca Market Data (datos intradía, Hito 2). Claves de una cuenta paper.
ALPACA_API_KEY_ID=
# El secreto también se acepta como ALPACA_SECRET_KEY.
ALPACA_API_SECRET_KEY=
# Obligatorio para enviar órdenes (Hito 3): sólo se admite paper trading.
ALPACA_PAPER=true

# Notificaciones (Hito 4, opcionales). Vacío = desactivado.
# Discord: Ajustes del canal > Integraciones > Webhooks > Copiar URL
#   formato: https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=
# Telegram: token de @BotFather (formato <número>:<texto>) y chat_id del chat o canal
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
